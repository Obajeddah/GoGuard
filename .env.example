# Copy to .env and fill in when hosting GoGuard yourself.

# Browser (public) — your Supabase-compatible backend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server only — never expose these to the browser
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key

# Paystack secret key (sk_test_... or sk_live_...)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# School signup security — both required; site key is public
TURNSTILE_SITE_KEY=0x4AAAAAAGTJ1cWng-5lVjqz
TURNSTILE_SECRET_KEY=0x4AAAAAAGTJ1eszdOGc6o9SEOFppHk-ovU

# Outbound email. Use Resend, or set EMAIL_API_URL (+ optional EMAIL_API_KEY)
# for a self-hosted JSON email relay. EMAIL_FROM must be a verified domain.
EMAIL_FROM=
RESEND_API_KEY=
EMAIL_API_URL=
EMAIL_API_KEY=

# Secret for POST /api/cron/send-emails; call it on a schedule from your host.
LOVABLE_CRON_SECRET=
# Optional: previous cron secret while rotating it (accepted during overlap)
LOVABLE_CRON_SECRET_PREVIOUS=